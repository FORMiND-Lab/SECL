+static int Cec4_GnnBuild(Cec4_Man_t *m, Vec_Bit_t *built, int node)
+{
+    Gia_Man_t *p = m->pAig;
+    Gia_Obj_t *o = Gia_ManObj(p, node), *n;
+    int a, b;
+    if (!node || Gia_ObjIsCi(o) || Vec_BitEntry(built, node)) return o->Value;
+    a = Abc_LitNotCond(Cec4_GnnBuild(m, built, Gia_ObjFaninId0p(p, o)), Gia_ObjFaninC0(o));
+    b = Abc_LitNotCond(Cec4_GnnBuild(m, built, Gia_ObjFaninId1p(p, o)), Gia_ObjFaninC1(o));
+    o->Value = Gia_ManHashAnd(m->pNew, a, b);
+    Vec_BitWriteEntry(built, node, 1);
+    m->nAndNodes++;
+    n = Gia_ManObj(m->pNew, Abc_Lit2Var(o->Value));
+    if (Gia_ObjIsAnd(n) && (Vec_BitEntry(m->vFails, Gia_ObjFaninId0p(m->pNew, n)) ||
+                           Vec_BitEntry(m->vFails, Gia_ObjFaninId1p(m->pNew, n))))
+        Vec_BitWriteEntry(m->vFails, Abc_Lit2Var(n->Value), 1);
+    return o->Value;
+}
+
+static void Cec4_GnnSweep(Cec4_Man_t *m)
+{
+    Gia_Man_t *p = m->pAig;
+    Vec_Int_t *order = Cec_GnnPrepassOrder(p);
+    Vec_Bit_t *built = Vec_BitStart(Gia_ManObjNum(p));
+    Gia_Obj_t *o, *r;
+    int node, k, repr;
+    Vec_IntForEachEntry(order, node, k) {
+        if (!Gia_ObjHasRepr(p, node) || Gia_ObjProved(p, node) || Gia_ObjFailed(p, node)) continue;
+        o = Gia_ManObj(p, node);
+        Cec4_GnnBuild(m, built, node);
+        r = Cec4_ManFindRepr(p, m, node);
+        if (!r) continue;
+        repr = Gia_ObjId(p, r);
+        Cec4_GnnBuild(m, built, repr);
+        if (Abc_Lit2Var(o->Value) == Abc_Lit2Var(r->Value)) {
+            assert((o->Value ^ r->Value) == (o->fPhase ^ r->fPhase));
+            Gia_ObjSetProved(p, node);
+            Cec_GnnRecordMerge(p, node, repr);
+            if (!repr) m->iLastConst = node;
+        } else if (Cec4_ManSweepNode(m, node, repr) && Gia_ObjProved(p, node))
+            o->Value = Abc_LitNotCond(r->Value, o->fPhase ^ r->fPhase);
+    }
+    Gia_ManForEachAnd(p, o, node) Cec4_GnnBuild(m, built, node);
+    Vec_IntFree(order); Vec_BitFree(built);
+}
