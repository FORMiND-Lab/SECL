 ////////////////////////////////////////////////////////////////////////
 ///                        DECLARATIONS                              ///
 ////////////////////////////////////////////////////////////////////////
+
+typedef struct Cec_Pair_t_
+{
+    int Id1;
+    int Id2;
+} Cec_Pair_t;
+
+static inline int Cec_UnionFindFind( int * pParent, int i )
+{
+    int Root = i;
+    while ( pParent[Root] != Root )
+        Root = pParent[Root];
+    while ( pParent[i] != i )
+    {
+        int Next = pParent[i];
+        pParent[i] = Root;
+        i = Next;
+    }
+    return Root;
+}
+
+static inline void Cec_UnionFindUnion( int * pParent, unsigned char * pRank, int i, int k )
+{
+    int RootI = Cec_UnionFindFind( pParent, i );
+    int RootK = Cec_UnionFindFind( pParent, k );
+    int Temp;
+    if ( RootI == RootK )
+        return;
+    if ( pRank[RootI] < pRank[RootK] )
+    {
+        Temp = RootI;
+        RootI = RootK;
+        RootK = Temp;
+    }
+    pParent[RootK] = RootI;
+    if ( pRank[RootI] == pRank[RootK] )
+        pRank[RootI]++;
+}
+
+static int Cec_PairCompare( const void * p1, const void * p2 )
+{
+    const Cec_Pair_t * pA = (const Cec_Pair_t *)p1;
+    const Cec_Pair_t * pB = (const Cec_Pair_t *)p2;
+    if ( pA->Id1 < pB->Id1 ) return -1;
+    if ( pA->Id1 > pB->Id1 ) return  1;
+    if ( pA->Id2 < pB->Id2 ) return -1;
+    if ( pA->Id2 > pB->Id2 ) return  1;
+    return 0;
+}
+
+// Record original IDs of objects merged by the last reduction.
+// Must run before the old manager is freed (Gia_ManOrigIdsRemap keeps one ID).
+static int Cec_ManCollectReductionOrigPairs( Gia_Man_t * pOld, Vec_Int_t * vPairs )
+{
+    Vec_Int_t * vReduced2Orig;
+    Gia_Obj_t * pObj;
+    int i, nAdded = 0;
+    if ( pOld == NULL || pOld->vIdsOrig == NULL || vPairs == NULL )
+        return 0;
+    vReduced2Orig = Vec_IntStartFull( Gia_ManObjNum(pOld) );
+    Gia_ManForEachObj( pOld, pObj, i )
+    {
+        int iReduced, iOrig, iOrigPrev;
+        if ( Gia_ObjIsCo(pObj) || !~pObj->Value )
+            continue;
+        iReduced = Abc_Lit2Var( pObj->Value );
+        if ( iReduced < 0 || iReduced >= Vec_IntSize(vReduced2Orig) )
+            continue;
+        iOrig = Vec_IntEntry( pOld->vIdsOrig, i );
+        if ( iOrig < 0 )
+            continue;
+        iOrigPrev = Vec_IntEntry( vReduced2Orig, iReduced );
+        if ( iOrigPrev == -1 )
+            Vec_IntWriteEntry( vReduced2Orig, iReduced, iOrig );
+        else if ( iOrigPrev != iOrig )
+        {
+            Vec_IntPushTwo( vPairs, iOrigPrev, iOrig );
+            nAdded++;
+        }
+    }
+    Vec_IntFree( vReduced2Orig );
+    return nAdded;
+}
+
+static void Cec_ManDumpFinalOrigClasses( Gia_Man_t * pAig, Vec_Int_t * vSatPairs, Vec_Int_t * vStructPairs, Vec_Int_t * vFailedPairs, const char * pFileName, int fVerbose )
+{
+    FILE * pFile;
+    Cec_Pair_t * pPairs = NULL;
+    Cec_Pair_t * pFailed = NULL;
+    int * pParent = NULL;
+    unsigned char * pRank = NULL;
+    int nRawSatPairs = 0, nRawStructPairs = 0, nRawPairs = 0;
+    int nValidPairs = 0, nUniquePairs = 0;
+    int nRawFailedPairs = vFailedPairs ? Vec_IntSize(vFailedPairs) / 2 : 0;
+    int nValidFailed = 0, nUnknown = 0, nResolvedFailed = 0;
+    int nBadPairs = 0, nObjects = pAig ? Gia_ManObjNum(pAig) : 0;
+    int k;
+    pFile = fopen( pFileName, "w" );
+    if ( pFile == NULL )
+    {
+        Abc_Print( -1, "Cannot open file \"%s\" for writing proof-closed original-ID pairs.\n", pFileName );
+        return;
+    }
+
+    if ( pAig && pAig->pName )
+        fprintf( pFile, "%s\n", pAig->pName );
+    else
+        fprintf( pFile, "circuit\n" );
+
+    nRawSatPairs = vSatPairs ? Vec_IntSize(vSatPairs) / 2 : 0;
+    nRawStructPairs = vStructPairs ? Vec_IntSize(vStructPairs) / 2 : 0;
+    nRawPairs = nRawSatPairs + nRawStructPairs;
+    if ( nRawPairs )
+        pPairs = ABC_ALLOC( Cec_Pair_t, nRawPairs );
+
+    for ( k = 0; k < nRawSatPairs; k++ )
+    {
+        int Id1 = Vec_IntEntry( vSatPairs, 2*k );
+        int Id2 = Vec_IntEntry( vSatPairs, 2*k + 1 );
+        int Temp;
+        if ( Id1 < 0 || Id2 < 0 || Id1 == Id2 )
+        {
+            nBadPairs++;
+            continue;
+        }
+        if ( Id1 > Id2 )
+        {
+            Temp = Id1;
+            Id1 = Id2;
+            Id2 = Temp;
+        }
+        pPairs[nValidPairs].Id1 = Id1;
+        pPairs[nValidPairs].Id2 = Id2;
+        nValidPairs++;
+    }
+    for ( k = 0; k < nRawStructPairs; k++ )
+    {
+        int Id1 = Vec_IntEntry( vStructPairs, 2*k );
+        int Id2 = Vec_IntEntry( vStructPairs, 2*k + 1 );
+        int Temp;
+        if ( Id1 < 0 || Id2 < 0 || Id1 == Id2 )
+        {
+            nBadPairs++;
+            continue;
+        }
+        if ( Id1 > Id2 )
+        {
+            Temp = Id1;
+            Id1 = Id2;
+            Id2 = Temp;
+        }
+        pPairs[nValidPairs].Id1 = Id1;
+        pPairs[nValidPairs].Id2 = Id2;
+        nValidPairs++;
+    }
+    if ( nValidPairs )
+        qsort( pPairs, nValidPairs, sizeof(Cec_Pair_t), Cec_PairCompare );
+    for ( k = 0; k < nValidPairs; k++ )
+    {
+        if ( nUniquePairs > 0 &&
+             pPairs[nUniquePairs-1].Id1 == pPairs[k].Id1 &&
+             pPairs[nUniquePairs-1].Id2 == pPairs[k].Id2 )
+            continue;
+        pPairs[nUniquePairs++] = pPairs[k];
+    }
 
+    if ( nUniquePairs )
+    {
+        for ( k = 0; k < nUniquePairs; k++ )
+            fprintf( pFile, "SAT_Proved: %d == %d\n", pPairs[k].Id1, pPairs[k].Id2 );
+    }
+    else
+        fprintf( pFile, "No_Proved\n" );
+
+    // failed pair is unknown only if it was not proved later
+    if ( nObjects > 0 && nRawFailedPairs > 0 )
+    {
+        pParent = ABC_ALLOC( int, nObjects );
+        pRank = ABC_CALLOC( unsigned char, nObjects );
+        pFailed = ABC_ALLOC( Cec_Pair_t, nRawFailedPairs );
+        for ( k = 0; k < nObjects; k++ )
+            pParent[k] = k;
+        for ( k = 0; k < nUniquePairs; k++ )
+            if ( pPairs[k].Id1 < nObjects && pPairs[k].Id2 < nObjects )
+                Cec_UnionFindUnion( pParent, pRank, pPairs[k].Id1, pPairs[k].Id2 );
+        for ( k = 0; k < nRawFailedPairs; k++ )
+        {
+            int iRepr = Vec_IntEntry( vFailedPairs, 2*k );
+            int iNode = Vec_IntEntry( vFailedPairs, 2*k + 1 );
+            if ( iRepr < 0 || iNode < 0 || iRepr >= nObjects || iNode >= nObjects || iRepr == iNode )
+            {
+                nBadPairs++;
+                continue;
+            }
+            if ( Cec_UnionFindFind(pParent, iRepr) == Cec_UnionFindFind(pParent, iNode) )
+            {
+                nResolvedFailed++;
+                continue;
+            }
+            pFailed[nValidFailed].Id1 = iNode;
+            pFailed[nValidFailed].Id2 = iRepr;
+            nValidFailed++;
+        }
+        if ( nValidFailed )
+        {
+            qsort( pFailed, nValidFailed, sizeof(Cec_Pair_t), Cec_PairCompare );
+            for ( k = 0; k < nValidFailed; k++ )
+            {
+                if ( k > 0 && pFailed[k-1].Id1 == pFailed[k].Id1 )
+                    continue;
+                fprintf( pFile, "SAT_Unknown: %d ?= %d\n", pFailed[k].Id1, pFailed[k].Id2 );
+                nUnknown++;
+            }
+        }
+    }
+    fclose( pFile );
+    if ( fVerbose )
+        Abc_Print( 1, "[orig-pairs] raw_sat=%d raw_merge=%d unique_proved=%d raw_failed=%d unresolved_nodes=%d resolved_failed=%d bad_pairs=%d -> \"%s\".\n",
+            nRawSatPairs, nRawStructPairs, nUniquePairs, nRawFailedPairs, nUnknown, nResolvedFailed, nBadPairs, pFileName );
+    ABC_FREE( pPairs );
+    ABC_FREE( pFailed );
+    ABC_FREE( pParent );
+    ABC_FREE( pRank );
+}
+
